pipeline {
    agent none

    stages {
        stage('Get Code') {
            agent { label 'built-in' }
            steps {
                echo 'Descargando código de la rama develop'
                git branch: 'develop', url: 'git@github.com:guiurm/unir-cp1-4.git'
                sh '''#!/bin/bash
                    set -x
                    curl -o samconfig.toml https://raw.githubusercontent.com/guiurm/todo-list-aws-config/refs/heads/staging/samconfig.toml
                '''
                stash name: 'codigo', includes: '**'
            }
        }

        stage('Static Test') {
            agent { label 'agent-01' }
            steps {
                unstash 'codigo'
                echo 'Ejecutando análisis estático con Flake8 y Bandit'
                sh '''#!/bin/bash
                    set -x

                    echo "=== Ejecutando Flake8 en src/ ==="
                    flake8 --exit-zero --format=pylint src/ > flake8.out
                    cat flake8.out

                    echo "=== Ejecutando Bandit en src/ ==="
                    bandit --exit-zero -r src/ -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}]{msg}"
                    cat bandit.out
                '''
            }
            post {
                always {
                    recordIssues(
                        tools: [
                            flake8(pattern: 'flake8.out'),
                            pyLint(name: 'Bandit', pattern: 'bandit.out')
                        ],
                        enabledForFailure: true
                    )
                }
            }
        }

        stage('Deploy') {
            agent { label 'built-in' }
            steps {
                unstash 'codigo'
                echo 'Construyendo y desplegando en entorno Staging'
                sh '''#!/bin/bash
                    set -x
                    sam validate --region us-east-1
                    sam build
                    sam deploy template.yaml --config-env staging --no-confirm-changeset --force-upload --no-fail-on-empty-changeset --no-progressbar
                '''
                script {
                    env.BASE_URL = sh(
                        script: "aws cloudformation describe-stacks --stack-name todo-list-aws-staging --query 'Stacks[0].Outputs[?OutputKey==`BaseUrlApi`].OutputValue' --region us-east-1 --output text",
                        returnStdout: true
                    ).trim()
                    echo "BASE_URL obtenida: ${env.BASE_URL}"
                }
            }
        }

        stage('Rest Test') {
            agent { label 'agent-02' }
            steps {
                unstash 'codigo'
                sh """#!/bin/bash
                    set -x
                    export BASE_URL=${env.BASE_URL}
                    pytest -s test/integration/todoApiTest.py
                """
            }
        }

        stage('Promote') {
            agent { label 'built-in' }
            steps {
                echo 'Haciendo merge a master'
                sshagent(['github']) {
                    sh '''#!/bin/bash
                        set -x
                        git config user.name "Jenkins"
                        git config user.email "jenkins@example.com"
                        git fetch origin
                        rm -f samconfig.toml
                        git checkout master
                        git merge develop --no-commit --no-ff
                        git reset HEAD Jenkinsfile_agentes
                        git checkout -- Jenkinsfile_agentes
                        git commit -m "Merge develop to master - Release approved"
                        git push origin master
                    '''
                }
            }
        }
    }

    post {
        always {
            node('built-in') {
                cleanWs()
            }
        }
    }
}